local function startAutoFish()
    if St.shut or St.fish then return end
    St.fish=true
    St.fsess=St.fsess+1
    local my=St.fsess
    task.spawn(function()
        local function ok() return not St.shut and St.fish and St.fsess==my end
        while ok() do
            local Event=getFishingEvent()
            if not Event then
                task.wait(0.5)
            else
                local okC,Character=pcall(function() return PLR.Character or PLR.CharacterAdded:Wait() end)
                local Root=okC and Character and Character:WaitForChild("HumanoidRootPart",5)
                if not Root then
                    task.wait(0.5)
                else
                    local CastPosition
                    local fp=Cfg.fpos
                    if type(fp)=="table" and tonumber(fp[1]) and tonumber(fp[2]) and tonumber(fp[3]) then
                        CastPosition=Vector3.new(fp[1],fp[2],fp[3])   -- spot the player picked
                    else
                        CastPosition=Root.Position+Root.CFrame.LookVector*10+Vector3.new(0,-8,0)
                    end
                    pcall(function() Event:FireServer("Cast",{Position=CastPosition}) end)
                    task.wait(0.01)
                    if not ok() then break end
                    local HoldStart=workspace:GetServerTimeNow()
                    pcall(function() Event:FireServer("LuckHold",{ClickTime=HoldStart}) end)
                    task.wait(0.01)
                    if not ok() then break end
                    pcall(function()
                        if type(firesignal)=="function" and Event.OnClientEvent then
                            firesignal(Event.OnClientEvent,"LuckHeld",{HoldStart=HoldStart,Speed=4})
                        end
                    end)
                    task.wait(0.01)
                    if not ok() then break end
                    pcall(function() Event:FireServer("LuckRelease",{ClickTime=workspace:GetServerTimeNow()}) end)
                    task.wait(0.01)
                    for Index=1,15 do
                        if not ok() then break end
                        pcall(function() Event:FireServer("Hit",{Index=Index}) end)
                        task.wait(0.01)
                    end
                    task.wait(0.1)
                end
            end
        end
    end)
end

-- ============================ TOWER TRACKING ============================
local function snapTowers()
    local s={}
    local tw_=workspace:FindFirstChild("Towers")
    if tw_ then for _,x in ipairs(tw_:GetChildren()) do s[x]=true end end
    return s
end
-- nearest tower that did NOT exist in `snap` and is not claimed yet
local function claimNew(snap,pos,claimed)
    local tw_=workspace:FindFirstChild("Towers")
    if not tw_ then return nil end
    local best,bd
    for _,x in ipairs(tw_:GetChildren()) do
        if not snap[x] and not claimed[x] then
            local ok,q=pcall(function() return x:GetPivot().Position end)
            if ok and q then
                local d=(Vector3.new(q.X,0,q.Z)-Vector3.new(pos.X,0,pos.Z)).Magnitude
                if d<40 and (not bd or d<bd) then best,bd=x,d end
            end
        end
    end
    return best
end

-- ============================ RECORDER ============================
local HR={PL=nil,UP=nil,SE=nil,SK=nil,SP=nil}
local function refreshHR()
    HR.PL=ens("p","RemoteFunctions","PlaceTower")
    HR.UP=ens("u","RemoteFunctions","UpgradeTower")
    HR.SE=ens("s","RemoteFunctions","SellTower")
    HR.SK=ens("w","RemoteEvents","SkipWaveVote")
    HR.SP=ens("g","RemoteEvents","SetGameSpeed")
end
refreshHR()
task.spawn(function()
    while not St.shut do
        if rec.active then refreshHR() end
        task.wait(5)
    end
end)

-- measure the exact cost of an action from the real cash drop
local function scheduleCost(act,w0,w1,startT)
    local e={act=act,s=startT}
    rec.pend[#rec.pend+1]=e
    local mine=rec.pend
    task.delay(math.max(0.05,w1-tick()+0.15),function()
        local hi=w1
        for _,o in ipairs(mine) do
            if o~=e and o.s and e.s and o.s>e.s and o.s<hi then hi=o.s end
        end
        local c=JH.spent(w0,hi)
        if c>0 then
            act.c=math.floor(c+0.5)
        elseif act.t=="U" and X.hookOk and JH.get and not JH.approx and JH.cash() then
            act.bad=true   -- no money left the wallet -> the upgrade was rejected
        end
        e.done=true
    end)
end
local function pushAct(act,w0,w1,startT)
    rec.a[#rec.a+1]=act
    act.w=JH.wave()
    if act.t=="P" or act.t=="U" then scheduleCost(act,w0,w1,startT) end
    X.setCount(#rec.a)
end

-- identify which remote was called (reference first, then by name)
local function classify(self)
    if typeof(self)~="Instance" then return nil end
    if self==HR.PL then return "PL" elseif self==HR.UP then return "UP" elseif self==HR.SE then return "SE"
    elseif self==HR.SK then return "SK" elseif self==HR.SP then return "SP" end
    local cn,nm=self.ClassName,self.Name
    if cn=="RemoteFunction" then
        if nm=="PlaceTower" then return "PL" elseif nm=="UpgradeTower" then return "UP" elseif nm=="SellTower" then return "SE" end
    elseif cn=="RemoteEvent" then
        if nm=="SkipWaveVote" then return "SK" elseif nm=="SetGameSpeed" then return "SP" elseif nm=="FishingEvent" then return "FI" end
    end
    return nil
end

-- runs deferred (after the real call went out), never inside the hook
local function onRemote(kind,args,t0,snap)
    if kind=="FI" then
        if St.pick and args[1]=="Cast" and X.onCastPicked then
            local p=args[2]
            if type(p)=="table" then p=p.Position end
            if typeof(p)=="Vector3" then X.onCastPicked(p) end
        end
        return
    end
    if not rec.active then return end
    local tk=t0
    local d=tk-(rec.l or tk)
    if kind=="PL" then
        local n,cf
        for i=1,(args.n or #args) do
            local v=args[i]
            if not n and type(v)=="string" then n=v end
            if not cf and typeof(v)=="CFrame" then cf=v end
        end
        if not n or not cf then return end
        local id=rec.n
        rec.n=id+1
        rec.l=tk
        local act={t="P",n=n,p={cf.Position.X,cf.Position.Y,cf.Position.Z},i=id,d=d}
        pushAct(act,t0-0.05,t0+0.9,t0)
        task.spawn(function()
            local t1=tick()
            while tick()-t1<3 and not St.shut do
                local inst=claimNew(snap or {},cf.Position,rec.k)
                if inst then
                    rec.t[id]=inst
                    rec.k[inst]=id
                    C.P=C.P+1
                    X.rfC()
                    return
                end
                task.wait(0.05)
            end
            act.bad=true   -- no tower appeared -> placement was rejected
        end)
    elseif kind=="UP" then
        local id=rec.k[args[1]]
        if id then
            rec.l=tk
            C.U=C.U+1 X.rfC()
            pushAct({t="U",i=id,d=d},t0-0.05,t0+0.9,t0)
        end
    elseif kind=="SE" then
        local inst=args[1]
        local id=rec.k[inst]
        if id then
            rec.l=tk
            C.S=C.S+1 X.rfC()
            pushAct({t="S",i=id,d=d},t0,t0,t0)
            rec.t[id]=nil
            rec.k[inst]=nil
        end
    elseif kind=="SK" then
        rec.l=tk
        pushAct({t="W",v=(type(args[1])=="number") and args[1] or nil,d=d},t0,t0,t0)
    elseif kind=="SP" then
        rec.l=tk
        pushAct({t="G",v=args[1],d=d},t0,t0,t0)
    end
end

-- IMPORTANT: the hook only OBSERVES. The real call is always a plain tail call,
-- so it can yield normally, and the namecall method is restored first.
local function hookBody(old,self,...)
    if St.shut or not (rec.active or St.pick) then return old(self,...) end
    local m=getnamecallmethod and getnamecallmethod() or ""
    if m~="InvokeServer" and m~="FireServer" then return old(self,...) end
    local ok,kind=pcall(classify,self)
    if ok and kind then
        local args=table.pack(...)
        local t0=tick()
        pcall(function()
            local snap=(kind=="PL") and snapTowers() or nil
            task.defer(onRemote,kind,args,t0,snap)
            rec.hits=rec.hits+1
        end)
        if setnamecallmethod then pcall(setnamecallmethod,m) end
    end
    return old(self,...)
end

local HOOK_MODE,HOOK_OK="none",false
do
    if type(hookmetamethod)=="function" and type(newcclosure)=="function" then
        HOOK_MODE="hookmetamethod"
        HOOK_OK=pcall(function()
            local old
            old=hookmetamethod(game,"__namecall",newcclosure(function(self,...)
                return hookBody(old,self,...)
            end))
        end)
    elseif type(getrawmetatable)=="function" and type(setreadonly)=="function" and type(newcclosure)=="function" then
        HOOK_MODE="getrawmetatable"
        HOOK_OK=pcall(function()
            local mt=getrawmetatable(game)
            local old=mt.__namecall
            setreadonly(mt,false)
            mt.__namecall=newcclosure(function(self,...)
                return hookBody(old,self,...)
            end)
            setreadonly(mt,true)
        end)
    end
end
X.hookOk=HOOK_OK
print("[JET HUB] hook: "..(HOOK_OK and HOOK_MODE or "none (passive mode)"))

-- passive mode (no hooking API): watch the Towers folder
local function clearPassive()
    for _,c in ipairs(passiveConns) do pcall(function() c:Disconnect() end) end
    passiveConns={}
end
local function getTowerName(t)
    for _,a in ipairs({"UnitName","TowerName","Type","Unit","UnitType","Tower"}) do
        local v=t:GetAttribute(a)
        if type(v)=="string" and v~="" then return v end
    end
    for _,c in ipairs(t:GetChildren()) do
        if c:IsA("StringValue") and (c.Name:lower():find("type") or c.Name:lower():find("name")) and c.Value~="" then
            return c.Value
        end
    end
    return t.Name
end
local function watchTower(tower,id)
    passiveConns[#passiveConns+1]=tower.AttributeChanged:Connect(function(attr)
        if not rec.active or St.shut then return end
        local l=attr:lower()
        if l=="level" or l=="tier" or l=="upgrade" or l=="rank" or l=="upgraded" then
            C.U=C.U+1 X.rfC()
            local tk=tick()
            local d=tk-(rec.l or tk)
            rec.l=tk
            pushAct({t="U",i=id,d=d},tk-1.0,tk+0.3,nil)
        end
    end)
    passiveConns[#passiveConns+1]=tower.Destroying:Connect(function()
        if not rec.active or St.shut then return end
        if rec.k[tower]~=id then return end
        if endScreen() then return end
        C.S=C.S+1 X.rfC()
        local tk=tick()
        local d=tk-(rec.l or tk)
        rec.l=tk
        pushAct({t="S",i=id,d=d},tk,tk,nil)
        rec.t[id]=nil
        rec.k[tower]=nil
    end)
end
local function onTowerAdded(tower)
    if not rec.active or St.shut then return end
    if knownTowers[tower] then return end
    knownTowers[tower]=true
    local ok,cf=pcall(function() return tower:GetPivot() end)
    if not ok or not cf then return end
    C.P=C.P+1 X.rfC()
    local id=rec.n
    rec.n=id+1
    local tk=tick()
    local d=tk-(rec.l or tk)
    rec.l=tk
    rec.t[id]=tower
    rec.k[tower]=id
    pushAct({t="P",n=getTowerName(tower),p={cf.Position.X,cf.Position.Y,cf.Position.Z},i=id,d=d},tk-1.0,tk+0.3,nil)
    watchTower(tower,id)
end
local function startPassive()
    knownTowers={}
    clearPassive()
    local tw_=workspace:FindFirstChild("Towers")
    if tw_ then
        for _,t in ipairs(tw_:GetChildren()) do knownTowers[t]=true end
        passiveConns[#passiveConns+1]=tw_.ChildAdded:Connect(onTowerAdded)
    else
        local wc
        wc=workspace.ChildAdded:Connect(function(child)
            if St.shut or child.Name~="Towers" then return end
            if wc then wc:Disconnect() end
            for _,t in ipairs(child:GetChildren()) do knownTowers[t]=true end
            passiveConns[#passiveConns+1]=child.ChildAdded:Connect(onTowerAdded)
        end)
        passiveConns[#passiveConns+1]=wc
    end
end

local function stopRecording()
    if not rec.active then
        set("rec",false)
        X.setStatus("Idle")
        return
    end
    rec.active=false
    rec.finishing=true
    set("rec",false)
    if not HOOK_OK then clearPassive() end
    X.setStatus("Recording","Measuring exact costs...")
    task.spawn(function()
        local t=tick()
        while tick()-t<3 do
            local all=true
            for _,e in ipairs(rec.pend) do if not e.done then all=false break end end
            if all then break end
            task.wait(0.1)
        end
        local out={}
        for _,a in ipairs(rec.a) do if not a.bad then out[#out+1]=a end end
        if #out>0 and Cfg.sel~="" then
            local miss=0
            for _,a in ipairs(out) do if (a.t=="P" or a.t=="U") and not a.c then miss=miss+1 end end
            if wj(FO..Cfg.sel..".json",out) then
                if JH.get==nil then
                    N("Saved "..#out.." steps (cash not found - timing mode)","warn")
                elseif miss>0 then
                    N("Saved "..#out.." steps ("..miss.." costs unknown, will be learned)","warn")
                else
                    N("Saved "..#out.." steps - every cost captured","ok")
                end
            else
                N("Save failed (writefile unsupported?)","bad")
            end
        else
            N("Nothing recorded (hook="..HOOK_MODE.." hits="..rec.hits..")","warn")
        end
        rec.finishing=false
        resetRec()
        X.setCount(0)
        X.setStatus("Idle")
    end)
end

-- ============================ PLAYBACK ============================
local function stopPlayback()
    St.playing=false
    St.psess=St.psess+1
    X.setStatus("Idle")
    set("pl",false)
end

local function startPlayback()
    if St.shut or St.playing then return end
    St.psess=St.psess+1
    local my=St.psess
    St.playing=true
    X.setStatus("Playing","Starting...")
    X.setStep("Starting macro","Preparing...",nil)
    task.spawn(function()
        local function alive() return St.playing and St.psess==my and not St.shut end
        local roundDetail=nil
        local lastUI,shownWait=0,false
        -- shows "waiting for cash $X (have $Y, short $Z)" in the Status card
        local function waitUI(need,c)
            local now=tick()
            if now-lastUI<0.1 then return end
            lastUI=now
            shownWait=true
            local msg=string.format("Waiting for cash $%s  (have $%s  short $%s)",JH.full(need),JH.full(c),JH.full(math.max(0,need-c)))
            X.setPhase(msg)
            X.setDetail(msg)
        end
        local function restoreDetail()
            if shownWait then
                shownWait=false
                if roundDetail then X.setDetail(roundDetail) end
            end
        end

        local function waitNextRound()
            local t=tick()
            while alive() and roundActive() and tick()-t<1800 do task.wait(0.5) end
            t=tick()
            while alive() and not roundActive() and tick()-t<600 do task.wait(0.5) end
            if alive() then task.wait(1) end
        end

        -- ---------- labels / status ----------
        local function actLabel(a,names)
            if not a then return "" end
            if a.t=="P" then return "Place("..tostring(a.n)..")"
            elseif a.t=="U" then return "Upgrade("..tostring(names[a.i] or ("#"..tostring(a.i)))..")"
            elseif a.t=="S" then return "Sell("..tostring(names[a.i] or ("#"..tostring(a.i)))..")"
            elseif a.t=="W" then return "Skip wave()"
            else return "Speed("..tostring(a.v)..")" end
        end

        -- ---------- cost correction ----------
        -- step used when the learned cost was too low: exactly 1 for normal prices,
        -- ~0.1% for huge prices (the real drop is measured afterwards anyway)
        local function stepFor(n)
            if n<10000 then return 1 end
            return 10^(math.floor(math.log10(n))-3)
        end
        -- write the corrected price straight back into the macro file
        local function fixCost(ctx,idx,a,real)
            real=math.floor((tonumber(real) or 0)+0.5)
            if real<=0 or a.c==real then return end
            local old=a.c
            a.c=real
            JH.learned[Cfg.sel..":"..idx]=real
            wj(FO..Cfg.sel..".json",ctx.data)
            N(string.format("Fixed macro cost at step %d: %s -> %s",idx,old and JH.full(old) or "?",JH.full(real)),"ok")
        end
        local function afterBuy(ctx,idx,a,sp,need,corrected)
            if JH.approx then return end   -- GUI text source is only approximate
            local real=(sp and sp>0) and sp or (corrected and need) or nil
            if real then fixCost(ctx,idx,a,real) end
        end

        local function doPlace(a,idx,ctx,useCash,runOk)
            local PL=ens("p","RemoteFunctions","PlaceTower")
            if not PL then N("PlaceTower remote not found","bad") return end
            local cf=CFrame.new(a.p[1],a.p[2],a.p[3])
            local key=Cfg.sel..":"..idx
            local need=useCash and (JH.learned[key] or a.c or 0) or 0
            local lim=(a.c and a.c>0) and a.c*3 or math.huge
            local tries,placed,hard,corrected=0,false,0,false
            local maxTry=useCash and 400 or 15
            local deadline=tick()+240
            while runOk() and not placed and tries<maxTry and tick()<deadline do
                if useCash and need>0 then
                    local okw=JH.waitCash(need,runOk,function(c) waitUI(need,c) end,corrected)
                    restoreDetail()
                    if not okw then return end
                end
                tries=tries+1
                X.setPhase(corrected and string.format("Trying price %s ...",JH.full(need)) or ("Placing("..tostring(a.n)..")"))
                local c0,t0=JH.cash(),tick()
                local snap=snapTowers()
                local okc,res=pcall(function() return PL:InvokeServer(a.n,cf) end)
                local inst
                if okc and res~=false then
                    local t1=tick()
                    while tick()-t1<4 and runOk() do
                        inst=claimNew(snap,cf.Position,ctx.k)
                        if inst then break end
                        task.wait(0.05)
                    end
                end
                if inst then
                    ctx.t[a.i]=inst
                    ctx.k[inst]=a.i
                    placed=true
                    C.P=C.P+1 X.rfC()
                    X.setPhase("Placed OK")
                    if useCash then
                        local sp=JH.confirm(key,c0,t0,need)
                        afterBuy(ctx,idx,a,sp,need,corrected)
                    end
                else
                    local c=JH.cash()
                    if useCash and c then
                        if a.c and c>=a.c*1.5 then
                            hard=hard+1
                            if hard>=4 then break end
                        end
                        -- bought nothing although we thought the cash was enough:
                        -- the real price is higher -> raise it by a tiny step and retry fast
                        need=math.max(need,c)+stepFor(math.max(need,c,1))
                        corrected=true
                        if need>lim then break end
                        task.wait()
                    else
                        task.wait(0.3)
                    end
                end
            end
            if not placed and runOk() then
                warn("[JET HUB] could not place "..tostring(a.n).." (step "..idx..")")
                N("Could not place "..tostring(a.n).." (step "..idx..")","warn")
            end
        end

        local function doUpgrade(a,idx,ctx,useCash,runOk)
            local UP=ens("u","RemoteFunctions","UpgradeTower")
            if not UP then N("UpgradeTower remote not found","bad") return end
            local inst=ctx.t[a.i]
            if not inst or not inst.Parent then
                warn("[JET HUB] upgrade skipped, tower #"..tostring(a.i).." is missing (step "..idx..")")
                X.setPhase("Skipped - no unit to upgrade")
                return
            end
            local key=Cfg.sel..":"..idx
            local need=useCash and (JH.learned[key] or a.c or 0) or 0
            local lim=(a.c and a.c>0) and a.c*3 or math.huge
            local tries,done,hard,corrected=0,false,0,false
            local deadline=tick()+180
            while runOk() and not done and tries<(useCash and 400 or 30) and inst.Parent and tick()<deadline do
                if useCash and need>0 then
                    local okw=JH.waitCash(need,runOk,function(c) waitUI(need,c) end,corrected)
                    restoreDetail()
                    if not okw then return end
                end
                tries=tries+1
                X.setPhase(corrected and string.format("Trying price %s ...",JH.full(need)) or ("Upgrading(#"..tostring(a.i)..")"))
                local c0,t0=JH.cash(),tick()
                local okc,res=pcall(function() return UP:InvokeServer(inst) end)
                if okc and res~=false then
                    if res==true or not useCash or need<=0 or not c0 then
                        done=true
                    else
                        done=JH.waitDrop(c0,0.4)
                    end
                end
                if done then
                    C.U=C.U+1 X.rfC()
                    X.setPhase("Upgraded OK")
                    if useCash then
                        local sp=JH.confirm(key,c0,t0,need)
                        afterBuy(ctx,idx,a,sp,need,corrected)
                    end
                else
                    local c=JH.cash()
                    if useCash and c then
                        if a.c and c>=a.c*1.5 then
                            hard=hard+1
                            if hard>=4 then break end
                        end
                        need=math.max(need,c)+stepFor(math.max(need,c,1))
                        corrected=true
                        if need>lim then break end
                        task.wait()
                    else
                        task.wait(0.25)
                    end
                end
            end
        end

        local function doAction(a,idx,ctx,useCash,runOk)
            local total=#ctx.data
            X.setStep(string.format("Step %d / %d",idx,total),idx..": "..actLabel(a,ctx.names),
                ctx.data[idx+1] and ((idx+1)..": "..actLabel(ctx.data[idx+1],ctx.names)) or nil)
            -- wait for the wave this action was recorded in
            if useCash and Cfg.nw~=false then
                -- ignore wave and time: act as soon as the cash is enough
            elseif useCash and a.w~=nil and JH.wave()~=nil then
                while runOk() do
                    local cw=JH.wave()
                    if not cw or cw>=a.w then break end
                    X.setPhase(string.format("Waiting wave(%d)  now wave %d",a.w,cw))
                    task.wait(0.1)
                end
            elseif (a.d or 0)>0 then
                X.setPhase(string.format("Waiting(%.1fs)",a.d))
                local t0=tick()
                while tick()-t0<a.d and runOk() do task.wait(0.05) end
            end
            if not runOk() then return end
            if a.t=="P" then
                doPlace(a,idx,ctx,useCash,runOk)
            elseif a.t=="U" then
                doUpgrade(a,idx,ctx,useCash,runOk)
            elseif a.t=="S" then
                X.setPhase("Selling...")
                local SE=ens("s","RemoteFunctions","SellTower")
                local inst=ctx.t[a.i]
                if SE and inst and inst.Parent then
                    pcall(function() SE:InvokeServer(inst) end)
                    C.S=C.S+1 X.rfC()
                    ctx.t[a.i]=nil
                    ctx.k[inst]=nil
                end
                X.setPhase("Sold OK")
            elseif a.t=="W" then
                local SK=ens("w","RemoteEvents","SkipWaveVote")
                if SK then pcall(function() SK:FireServer(a.v or 1) end) end
                X.setPhase("Wave skipped")
            elseif a.t=="G" then
                local SP=ens("g","RemoteEvents","SetGameSpeed")
                if SP then pcall(function() SP:FireServer(a.v) end) end
                X.setPhase("Speed set")
            end
        end

        local round=0
        while alive() do
            local data=loadMacro(Cfg.sel)
            if not data or #data==0 then
                N("Macro is empty - record it first","bad")
                break
            end
            if not roundActive() then
                X.setStatus("Playing","Waiting for the round to start...")
                X.setStep("Waiting for round","Waiting for the round to start...",nil)
                local t0=tick()
                while alive() and not roundActive() and tick()-t0<600 do task.wait(0.4) end
                if not alive() then break end
                task.wait(0.6)
            end
            round=round+1
            C.P=0 C.U=0 C.S=0 X.rfC()
            local names={}
            for _,x in ipairs(data) do if x.t=="P" then names[x.i]=x.n end end
            local ctx={t={},k={},data=data,names=names}
            local useCash=(Cfg.cm~=false) and JH.cash()~=nil
            roundDetail=string.format("Round %d | %d steps | %s",round,#data,useCash and ("cash mode ("..JH.src..")") or "timing mode")
            X.setStatus("Playing",roundDetail)
            local offSince
            local function runOk()
                if not alive() then return false end
                if roundActive() then offSince=nil return true end
                offSince=offSince or tick()
                return tick()-offSince<1.5
            end
            for idx,a in ipairs(data) do
                if not runOk() then break end
                local ok,err=pcall(doAction,a,idx,ctx,useCash,runOk)
                if not ok then
                    warn("[JET HUB] step "..idx.." error: "..tostring(err))
                end
            end
            if not alive() then break end
            X.setStatus("Playing","Macro finished - waiting for next round")
            X.setPhase("Macro finished - waiting for next round")
            waitNextRound()
        end
        if St.psess==my then
            St.playing=false
            St.psess=St.psess+1
            X.setStatus("Idle")
            set("pl",false)
            if X.pToggle and X.pToggle.GetValue() then X.pToggle.SetValue(false) end
        end
    end)
end

