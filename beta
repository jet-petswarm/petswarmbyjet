local function tw(o,t,p,style,dir)
    if not o or not o.Parent then return end
    pcall(function()
        TS:Create(o,TweenInfo.new(t or 0.2,style or Enum.EasingStyle.Quart,dir or Enum.EasingDirection.Out),p):Play()
    end)
end

-- objects whose colour follows the accent
local themed={}
local function th(o,prop,fn)
    themed[#themed+1]={o=o,p=prop,f=fn}
    pcall(function() o[prop]=fn and fn() or K.ac end)
    return o
end
local function applyTheme(c,instant)
    K.ac=c
    for i=#themed,1,-1 do
        local e=themed[i]
        if not e.o or not e.o.Parent then
            table.remove(themed,i)
        else
            local v=e.f and e.f() or c
            if instant or typeof(v)=="ColorSequence" then
                pcall(function() e.o[e.p]=v end)
            else
                tw(e.o,0.3,{[e.p]=v})
            end
        end
    end
end

local function dragify(handle,target,onTap)
    local dragging,moved,start,orig=false,false,nil,nil
    ac(handle.InputBegan:Connect(function(i)
        if St.shut then return end
        if i.UserInputType==Enum.UserInputType.MouseButton1 or i.UserInputType==Enum.UserInputType.Touch then
            dragging=true moved=false start=i.Position orig=target.Position
        end
    end))
    ac(UIS.InputChanged:Connect(function(i)
        if St.shut or not dragging then return end
        if i.UserInputType==Enum.UserInputType.MouseMovement or i.UserInputType==Enum.UserInputType.Touch then
            local d=i.Position-start
            if d.Magnitude>5 then moved=true end
            if moved then
                target.Position=UDim2.new(orig.X.Scale,orig.X.Offset+d.X,orig.Y.Scale,orig.Y.Offset+d.Y)
            end
        end
    end))
    ac(UIS.InputEnded:Connect(function(i)
        if i.UserInputType==Enum.UserInputType.MouseButton1 or i.UserInputType==Enum.UserInputType.Touch then
            if dragging then
                dragging=false
                if not moved and onTap then onTap() end
            end
        end
    end))
end

