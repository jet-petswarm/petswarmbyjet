local cImp=Card(pShare,"Import")
local importBox=Input(cImp,'Paste macro JSON here  {"Name":"...","Actions":[...]}',"",84,true)
local importName=Input(cImp,"Macro name (optional - taken from JSON)","",36)
Button(cImp,"Import and Save","p",function()
    local raw=importBox.Text or ""
    if #raw<2 then N("Paste the macro JSON first","warn") return end
    if raw:sub(1,5)=="EZVC:" then raw=raw:sub(6) elseif raw:sub(1,4)=="JET:" then raw=raw:sub(5) end
    raw=raw:match("^%s*(.-)%s*$") or raw
    local ok,decoded=pcall(function() return HS:JSONDecode(raw) end)
    if not ok or type(decoded)~="table" then N("Invalid JSON","bad") return end
    local actions,nm
    if type(decoded.Actions)=="table" then actions=decoded.Actions nm=decoded.Name
    elseif decoded[1]~=nil then actions=decoded end
    if not actions then N("Invalid macro data","bad") return end
    local clean={}
    for _,a in ipairs(actions) do
        local s=sanitizeAction(a)
        if s then clean[#clean+1]=s end
    end
    if #clean==0 then N("No valid actions found","bad") return end
    local name=(importName.Text or ""):match("^%s*(.-)%s*$") or ""
    if name=="" and type(nm)=="string" then name=nm end
    name=(name:gsub('[\\/:%*%?"<>|]','')):match("^%s*(.-)%s*$") or ""
    if name=="" then name="Imported_"..tostring(os.time()) end
    if wj(FO..name..".json",clean) then
        pickMacro(name)
        importBox.Text=""
        importName.Text=""
        N("Imported "..#clean.." steps -> "..name,"ok")
    else
        N("Save failed (writefile unsupported?)","bad")
    end
end)

