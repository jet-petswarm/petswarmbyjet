        {"Could not place ","วางไม่สำเร็จ "},{"Nothing recorded","ไม่มีอะไรถูกบันทึก"},
    }
    local SUBS={
        {" steps"," ขั้นตอน"},{"cash mode","โหมดเงิน"},{"timing mode","โหมดเวลา"},{"(exact)","(แน่นอน)"},
        {"(approximate)","(ประมาณ)"},{" ~approx"," ~ประมาณ"},{" exact"," แน่นอน"},{"cash NOT found","ไม่พบเงิน"},
        {"  |  cash ","  |  เงิน "},{"costs unknown, will be learned","ไม่ทราบราคา จะเรียนรู้เอง"},
        {"every cost captured","จับราคาครบทุกขั้น"},{"not detected","ยังไม่พบ"},{"(step ","(ขั้นที่ "},
        {"Place(","วางตัว("},{"Upgrade(","อัพเกรด("},{"Sell(","ขายตัว("},{"Skip wave()","ข้ามเวฟ()"},{"Speed(","ปรับสปีด("},
    }
    local RULES={
        {"^Place (%d+)  |  Upgrade (%d+)  |  Sell (%d+)$","^วาง (%d+)  |  อัปเกรด (%d+)  |  ขาย (%d+)$","Place %s  |  Upgrade %s  |  Sell %s","วาง %s  |  อัปเกรด %s  |  ขาย %s"},
        {"^(%d+) actions$","^(%d+) การกระทำ$","%s actions","%s การกระทำ"},
        {"^Step (%d+) / (%d+)$","^ขั้นที่ (%d+) / (%d+)$","Step %s / %s","ขั้นที่ %s / %s"},
        {"^Waiting for cash %$(.-)  %(have %$(.-)  short %$(.-)%)$","^รอเงิน %$(.-)  %(มี %$(.-)  ขาดอีก %$(.-)%)$","Waiting for cash $%s  (have $%s  short $%s)","รอเงิน $%s  (มี $%s  ขาดอีก $%s)"},
        {"^Waiting wave%((%d+)%)  now wave (%d+)$","^รอเวฟ%((%d+)%)  ตอนนี้เวฟ (%d+)$","Waiting wave(%s)  now wave %s","รอเวฟ(%s)  ตอนนี้เวฟ %s"},
        {"^Waiting%((.-)%)$","^รอเวลา%((.-)%)$","Waiting(%s)","รอเวลา(%s)"},
        {"^Trying price (.-) %.%.%.$","^ลองซื้อที่ราคา (.-) %.%.%.$","Trying price %s ...","ลองซื้อที่ราคา %s ..."},
        {"^Round (%d+) | (.*)$","^รอบ (%d+) | (.*)$","Round %s | %s","รอบ %s | %s"},
        {"^Next  (.*)$","^ถัดไป  (.*)$","Next  %s","ถัดไป  %s"},
        {"^Fixed macro cost at step (%d+): (.-) %->  ?(.-)$","^แก้ราคาในมาโคร ขั้น (%d+): (.-) →  ?(.-)$","Fixed macro cost at step %s: %s -> %s","แก้ราคาในมาโคร ขั้น %s: %s → %s"},
        {"^(%d+): (.*)$","^(%d+): (.*)$","%s: %s","%s: %s"},
    }
    local TH,EN={},{}
    for _,p in ipairs(PAIRS) do
        TH[p[1]]=p[2]
        TH[string.upper(p[1])]=p[2]
        if EN[p[2]]==nil then EN[p[2]]=p[1] end
    end
    local function subs(s,a,b)
        for _,p in ipairs(SUBS) do
            local i,j=string.find(s,p[a],1,true)
            if i then s=string.sub(s,1,i-1)..p[b]..string.sub(s,j+1) end
        end
        return s
    end
    local function startsWith(s,p) return string.sub(s,1,#p)==p end
    function L.tr(s,isLabel)
        if type(s)~="string" or s=="" then return s end
        local toTh=(L.lang=="th")
        local v
        if toTh then v=TH[s] else v=EN[s] end
        if v then return v end
        local from,to=toTh and 1 or 2,toTh and 2 or 1
        for _,r in ipairs(RULES) do
            local caps={string.match(s,toTh and r[1] or r[2])}
            if #caps>0 then
                local ok,res=pcall(string.format,toTh and r[4] or r[3],table.unpack(caps))
                if ok then return subs(res,from,to) end
            end
        end
        for _,p in ipairs(PREF) do
            if (not isLabel or p[3]) and startsWith(s,p[from]) then
                return subs(p[to]..string.sub(s,#p[from]+1),from,to)
            end
        end
        if isLabel then return s end
        return subs(s,from,to)
    end
end
-- Event driven: every label is translated the moment its Text changes (same frame),
-- so the script's own English text never shows up between two polling ticks.
function L.sync(d,e)
    if e.busy or St.shut then return end
    local cur=d.Text
    if cur==e.t then return end          -- this is our own translated text
    e.o=cur                               -- the script wrote new text -> new original
    local nt=L.tr(cur,true)
    e.t=nt
    if nt~=cur then
        e.busy=true
        pcall(function() d.Text=nt end)
        e.busy=false
    end
end
function L.hook(d)
    if L.reg[d] then return L.reg[d] end
    if not (d:IsA("TextLabel") or d:IsA("TextButton")) then return nil end
    local e={o=d.Text,t=d.Text,busy=false}
    L.reg[d]=e
    local cur=d.Text
    if cur~="" then
        local nt=L.tr(cur,true)
        e.t=nt
        if nt~=cur then
            e.busy=true
            pcall(function() d.Text=nt end)
            e.busy=false
        end
    end
    d:GetPropertyChangedSignal("Text"):Connect(function() L.sync(d,e) end)
    return e
end
function L.apply()
    if St.shut then return end
    for _,d in ipairs(sg:GetDescendants()) do
        if d:IsA("TextLabel") or d:IsA("TextButton") then
            local e=L.reg[d]
            if e then L.sync(d,e) else L.hook(d) end
        end
    end
end
function L.set(lang)
    L.lang=(lang=="th") and "th" or "en"
    if St.shut then return end
    for _,d in ipairs(sg:GetDescendants()) do
        if d:IsA("TextLabel") or d:IsA("TextButton") then
            local e=L.reg[d] or L.hook(d)
            if e then
                local cur=d.Text
                if cur~=e.t then e.o=cur end
                local nt=L.tr(e.o,true)
                e.t=nt
                if nt~=cur then
                    e.busy=true
                    pcall(function() d.Text=nt end)
                    e.busy=false
                end
            end
        end
    end
end
ac(sg.DescendantAdded:Connect(function(d)
    if St.shut then return end
    if d:IsA("TextLabel") or d:IsA("TextButton") then task.defer(L.hook,d) end
end))
task.spawn(function()
    while not St.shut do
        pcall(L.apply)       -- safety net only
        task.wait(0.5)
    end
end)

