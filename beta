-- ============================ AUTO RECONNECT ============================
-- Rejoins the map below whenever the client is disconnected or kicked (error prompt / error message).
local RECONNECT_PLACE_ID=99703116573266
local arcBusy=false
local arcConns={}
local function arcClear()
    for _,c in ipairs(arcConns) do pcall(function() c:Disconnect() end) end
    arcConns={}
end
local function tryRejoin(force)
    if St.shut or arcBusy then return end
    if not force and not Cfg.arc then return end
    arcBusy=true
    pcall(function() N("Disconnected - reconnecting...","warn") end)
    task.spawn(function()
        local TPS=game:GetService("TeleportService")
        -- optional: re-run the hub in the new server if the executor supports queue_on_teleport
        pcall(function()
            local q=queue_on_teleport or (syn and syn.queue_on_teleport) or (fluxus and fluxus.queue_on_teleport)
            local boot=getgenv and getgenv().JetHubBoot
            if q and type(boot)=="string" and boot~="" then q(boot) end
        end)
        local tries=0
        while not St.shut and (force or Cfg.arc) and tries<60 do
            tries=tries+1
            pcall(function() TPS:Teleport(RECONNECT_PLACE_ID,PLR) end)
            task.wait(12)
        end
        arcBusy=false
    end)
end
function armReconnect()
    arcClear()
    if St.shut or not Cfg.arc then return end
    local GS=game:GetService("GuiService")
    arcConns[#arcConns+1]=ac(GS.ErrorMessageChanged:Connect(function(msg)
        if msg and msg~="" then tryRejoin(false) end
    end))
    task.spawn(function()
        local ok,overlay=pcall(function()
            local cg=game:GetService("CoreGui")
            local gui=cg:WaitForChild("RobloxPromptGui",10)
            return gui and gui:WaitForChild("promptOverlay",10)
        end)
        if not ok or not overlay or St.shut then return end
        arcConns[#arcConns+1]=ac(overlay.ChildAdded:Connect(function(ch)
            if ch.Name=="ErrorPrompt" then tryRejoin(false) end
        end))
        if overlay:FindFirstChild("ErrorPrompt") then tryRejoin(false) end
    end)
end
Toggle(cUt,"Auto Reconnect","Rejoin the map automatically after a disconnect or kick",Cfg.arc,function(on)
    set("arc",on)
    armReconnect()
end)
