local function wj(p,d)
    if type(writefile)~="function" then return false end
    local ok,s=pcall(function() return HS:JSONEncode(d) end)
    if not ok then return false end
    return pcall(writefile,p,s)
end
local function rj(p)
    if type(isfile)~="function" or type(readfile)~="function" then return nil end
    local okf,ex=pcall(isfile,p)
    if not okf or not ex then return nil end
    local ok,d=pcall(readfile,p)
    if not ok then return nil end
    local ok2,a=pcall(function() return HS:JSONDecode(d) end)
    if not ok2 or type(a)~="table" then return nil end
    return a
end
local function lf()
    if type(listfiles)~="function" then return {} end
    local seen,n={},{}
    for _,p in ipairs({FO,"tdmacro","./tdmacro/"}) do
        local ok,list=pcall(listfiles,p)
        if ok and type(list)=="table" then
            for _,f in ipairs(list) do
                local x=tostring(f):match("([^/\\]+)%.json$")
                if x and x~="state" and x~="config" and not seen[x] then
                    seen[x]=true
                    n[#n+1]=x
                end
            end
        end
    end
    table.sort(n,function(a,b) return a:lower()<b:lower() end)
    return n
end

local function sanitizeAction(a)
    if type(a)~="table" then return nil end
    a.Method=nil a.method=nil a.bad=nil a._k=nil
    local t=a.t
    if t=="P" then
        if type(a.n)~="string" or type(a.p)~="table" then return nil end
        if type(a.p[1])~="number" or type(a.p[2])~="number" or type(a.p[3])~="number" then return nil end
        if type(a.i)~="number" then return nil end
    elseif t=="U" or t=="S" then
        if type(a.i)~="number" then return nil end
    elseif t~="W" and t~="G" then
        return nil
    end
    return a
end
local function loadMacro(name)
    if not name or name=="" then return nil end
    local data=rj(FO..name..".json")
    if type(data)~="table" then return nil end
    local clean={}
    for _,a in ipairs(data) do
        local s=sanitizeAction(a)
        if s then clean[#clean+1]=s end
    end
    return clean
end

