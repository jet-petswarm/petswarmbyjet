-- ============================ CASH SYSTEM ============================
-- Reads the real numeric cash value, measures exact costs from real drops.
local JH={hist={},src="not detected",approx=false,get=nil,lastDetect=0,learned={},cands={},sampling=false}
do
    local MONEY_SUF={k=1e3,m=1e6,b=1e9,t=1e12,qa=1e15,qi=1e18,sx=1e21,sp=1e24,oc=1e27,no=1e30,dc=1e33}
    local NAMEP={{"^cash$",100},{"^money$",95},{"^coins?$",90},{"^gold$",85},{"cash",60},{"money",55},{"coin",50},{"gold",45}}
    local BAD={"max","total","earn","per","rate","gain","income","spent","best","mult","boost","limit","gem","premium","robux","rebirth","wins","kill","lifetime","goal","need","cost","price","time"}

    local function scoreName(n)
        n=tostring(n):lower()
        for _,b in ipairs(BAD) do if n:find(b,1,true) then return 0 end end
        for _,p in ipairs(NAMEP) do if n:find(p[1]) then return p[2] end end
        return 0
    end
    function JH.parse(txt)
        txt=tostring(txt or ""):lower()
        txt=txt:gsub(",","")
        local n,suf=txt:match("(%d+%.?%d*)%s*(%a*)")
        n=tonumber(n)
        if not n then return nil,false end
        local abbreviated=false
        if suf and suf~="" then
            local m=MONEY_SUF[suf]
            if m then n=n*m abbreviated=true end
        end
        return n,abbreviated
    end
    function JH.fmt(n)
        n=tonumber(n) or 0
        local t={{1e15,"Qa"},{1e12,"T"},{1e9,"B"},{1e6,"M"},{1e3,"K"}}
        for _,v in ipairs(t) do
            if n>=v[1] then return string.format("%.2f%s",n/v[1],v[2]) end
        end
        return tostring(math.floor(n))
    end
    function JH.full(n)
        local s=string.format("%.0f",tonumber(n) or 0)
        local r=s:reverse():gsub("(%d%d%d)","%1,"):reverse()
        return (r:gsub("^,",""))
    end

    local function isNum(v) return v:IsA("IntValue") or v:IsA("NumberValue") end
    function JH.collect()
        local out={}
        local function add(label,get,approx,score)
            out[#out+1]={label=label,get=get,approx=approx,score=score}
        end
        local ls=PLR:FindFirstChild("leaderstats")
        if ls then
            for _,v in ipairs(ls:GetChildren()) do
                if v:IsA("ValueBase") and isNum(v) then
                    local s=scoreName(v.Name)
                    if s>0 then add("leaderstats."..v.Name,function() return tonumber(v.Value) end,false,s+30) end
                end
            end
        end
        for k,v in pairs(PLR:GetAttributes()) do
            if type(v)=="number" then
                local s=scoreName(k)
                if s>0 then add("attribute."..tostring(k),function() local x=PLR:GetAttribute(k) return type(x)=="number" and x or nil end,false,s+20) end
            end
        end
        for _,v in ipairs(PLR:GetDescendants()) do
            if v:IsA("ValueBase") and isNum(v) and v.Parent~=ls then
                local s=scoreName(v.Name)
                if s>0 then add("player."..v.Name,function() return tonumber(v.Value) end,false,s+10) end
            end
        end
        for _,fo in ipairs(RS:GetChildren()) do
            local pd=fo:FindFirstChild(PLR.Name) or fo:FindFirstChild(tostring(PLR.UserId))
            if pd then
                for _,v in ipairs(pd:GetDescendants()) do
                    if v:IsA("ValueBase") and isNum(v) then
                        local s=scoreName(v.Name)
                        if s>0 then add("data."..fo.Name.."."..v.Name,function() return tonumber(v.Value) end,false,s+5) end
                    end
                end
            end
        end
        local guiN=0
        for _,d in ipairs(PG:GetDescendants()) do
            if d:IsA("TextLabel") and guiN<12 then
                local s=scoreName(d.Name)
                local txt=tostring(d.Text)
                if s>0 and JH.parse(txt) then
                    guiN=guiN+1
                    add("gui."..d.Name,function() local n,ab=JH.parse(d.Text) JH.approx=ab return n end,true,s-20)
                elseif txt:match("^%s*%$%s*[%d%.,]+%s*%a*%s*$") and JH.parse(txt) then
                    guiN=guiN+1
                    add("gui."..d.Name.." (guess)",function() local n,ab=JH.parse(d.Text) JH.approx=ab return n end,true,5)
                end
            end
        end
        table.sort(out,function(a,b) return a.score>b.score end)
        return out
    end
    function JH.detect()
        JH.get=nil
        JH.src="not detected"
        JH.approx=false
        local list=JH.collect()
        JH.cands=list
        local pick
        if Cfg.csrc and Cfg.csrc~="" then
            for _,c in ipairs(list) do if c.label==Cfg.csrc then pick=c break end end
        end
        pick=pick or list[1]
        if not pick then return false end
        local ok,v=pcall(pick.get)
        if not ok or type(v)~="number" then return false end
        JH.get=pick.get
        JH.src=pick.label
        JH.approx=pick.approx
        return true
    end
    function JH.cash()
        if not JH.get and tick()-JH.lastDetect>8 then
            JH.lastDetect=tick()
            JH.detect()
        end
        if not JH.get then return nil end
        local ok,v=pcall(JH.get)
        if ok and type(v)=="number" then return v end
        JH.get=nil
        return nil
    end
    function JH.wave()
        local ws=RS:FindFirstChild("WaveState")
        local w=ws and ws:GetAttribute("CurrentWave")
        if type(w)=="number" then return w end
        return nil
    end
    -- total money that LEFT the wallet between t0 and t1 (income is ignored)
    function JH.spent(t0,t1)
        local h=JH.hist
        local prev,sum=nil,0
        for i=1,#h do
            local e=h[i]
            if e[1]<t0 then
                prev=e[2]
            elseif e[1]<=t1 then
                if prev and e[2]<prev then sum=sum+(prev-e[2]) end
                prev=e[2]
            end
        end
        return sum
    end
    function JH.waitCash(need,okf,tickf,fast)
        while okf() do
            local c=JH.cash()
            if not c or c>=need then return true end
            if tickf then tickf(c) end
            task.wait()
        end
        return false
    end
    function JH.waitDrop(c0,to)
        local t=tick()
        while tick()-t<to do
            local c=JH.cash()
            if c and c0 and c<c0 then return true end
            task.wait()
        end
        return false
    end
    -- after a successful purchase: read the real drop and remember it
    function JH.confirm(key,c0,t0,need)
        if not c0 then return 0 end
        JH.waitDrop(c0,0.5)
        task.wait()
        local sp=JH.spent(t0-0.05,tick())
        if sp>0 and (need<=0 or sp<=need*3) then JH.learned[key]=sp end
        return sp
    end
    -- sampler: stores every change of the cash value (once per frame)
    ac(RUN.Heartbeat:Connect(function()
        JH.sampling=rec.active or rec.finishing or St.playing
        if not JH.sampling then
            if #JH.hist>0 then JH.hist={} end
            return
        end
        local c=JH.cash()
        if not c then return end
        local h,now=JH.hist,tick()
        local last=h[#h]
        if not last or last[2]~=c then h[#h+1]={now,c} end
        while #h>1 and now-h[1][1]>8 do table.remove(h,1) end
    end))
end

